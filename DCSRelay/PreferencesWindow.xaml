<Window x:Class="DCSRelay.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences" Height="180" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <CheckBox x:Name="chkStartMinimized" Content="Start minimized" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <Label Content="DcsBiosCommandAddress:" VerticalAlignment="Center" />
            <TextBox x:Name="txtDcsBiosAddress" Width="220" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="OnSaveClicked" />
            <Button Content="Cancel" Width="80" Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
