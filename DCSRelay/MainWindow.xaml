<Window
        x:Class="DCSRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DCSRelay"
        xmlns:vm="clr-namespace:DCSRelay.ViewModels"
        xmlns:services="clr-namespace:DCSRelay.Services"
        mc:Ignorable="d"
        Title="DCS Relay" Height="450" Width="800"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="20" />
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Exit" Click="OnFileExitClicked" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Preferences" Click="OnEditPreferencesClicked" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="DCSRelay on GitHub" Click="OnHelpProjectGitHubClicked" />
                <MenuItem Header="DCSRelay Discord server" Click="OnHelpDiscordClicked" />
                <MenuItem Header="DCSRelay on Microsoft Store" Click="OnHelpMicrosoftStoreClicked" />
                <MenuItem Header="Sponsor this project" Click="OnHelpSponsorClicked" />
                <Separator />
                <MenuItem Header="About" Click="OnHelpAboutClicked" />
            </MenuItem>
        </Menu>
        <!-- Status Bar at the bottom -->
        <Grid DockPanel.Dock="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Height="30" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,0"  >
                    <Label Content="Multicast Bytes Received:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Label Content="{Binding BytesReceivedOnMulticast, StringFormat='0,0'}" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center"  Margin="10,0,10,0"/>
                <Separator />
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Right"  ToolTip="{Binding RelayServiceStatus}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Red" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelayServiceStatus}" Value="Relay: Running">
                                    <Setter Property="Fill" Value="LimeGreen" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Content="Available Serial Ports:" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>

            <!-- Available Ports List -->
            <ListBox x:Name="availableList"
                     Grid.Row="1" Grid.Column="0"
                     ItemsSource="{Binding AvailablePorts}"
                     SelectionMode="Extended"
                     SelectionChanged="OnAvailableListSelectionChanged"/>

            <!-- Move Buttons -->
            <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
                <Button x:Name="moveRightButton"
                        Command="{Binding MovePortRightCommand}"
                        Margin="5"
                        Width="32"
                        Height="32" Padding="0">
                    <Image Source="/Assets/ArrowRight.svg"/>
                </Button>
                <Button x:Name="moveLeftButton"
                        Command="{Binding MovePortLeftCommand}"
                        Margin="5"
                        Width="32"
                        Padding="0"
                        Height="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Assets/ArrowLeft.svg"/>
                </Button>

            </StackPanel>

            <!-- Active Ports List -->
            <Label Content="DCSBios Serial Ports:" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>
            <ListBox x:Name="activeList"
                     Grid.Row="1" Grid.Column="2"
                     ItemsSource="{Binding ActivePorts}"
                     SelectionMode="Extended"
                     SelectionChanged="OnActiveListSelectionChanged"/>
        </Grid>
    </DockPanel>
</Window>
